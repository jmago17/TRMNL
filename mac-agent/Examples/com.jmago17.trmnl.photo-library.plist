<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jmago17.trmnl.photo-library</string>

  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/trmnl-mac-agent</string>
    <string>photo-library</string>
    <string>--album</string>
    <string>TRMNL</string>
    <string>--mode</string>
    <string>latest</string>
  </array>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>/tmp/trmnl-photo-library.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/trmnl-photo-library.err</string>
</dict>
</plist>
